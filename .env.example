# Root .env for docker-compose (copy to .env and fill in).
# This file is committed; the real .env is gitignored — keep secrets out of git.

# --- Ports ---
# Host port the dashboard is published on (frontend). The backend is never
# published to the host (it holds the Docker socket and has no auth).
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Dashboard auth (NextAuth) ---
# Generate a strong secret, e.g.:  openssl rand -base64 32
NEXTAUTH_SECRET=changeme
ADMIN_USERNAME=admin
# Provide ONE of the two below. SHA256 is preferred (no plaintext password).
#   printf '%s' 'yourpassword' | sha256sum
ADMIN_PASSWORD_SHA256=
# ADMIN_PASSWORD=plainpassword

# --- Optional VPS defaults for the "VPS SFTP" tab ---
# Server-side (recommended for secrets — not shipped to the browser):
VPS_HOST=
VPS_PORT=22
VPS_USERNAME=
VPS_PASSWORD=
VPS_PRIVATE_KEY=
VPS_PATH=/etc/nginx/sites-available
VPS_DEFAULT_COMMAND=nginx -t

# Public alternative (exposed to the browser — avoid putting real secrets here):
# NEXT_PUBLIC_VPS_HOST=
# NEXT_PUBLIC_VPS_PORT=22
# NEXT_PUBLIC_VPS_USERNAME=
# NEXT_PUBLIC_VPS_PASSWORD=
# NEXT_PUBLIC_VPS_PRIVATE_KEY=
# NEXT_PUBLIC_VPS_PATH=/etc/nginx/sites-available
# NEXT_PUBLIC_VPS_DEFAULT_COMMAND=nginx -t
# If your password contains '#', wrap it in quotes: NEXT_PUBLIC_VPS_PASSWORD="fu5#0Fjx6jwFzC"
